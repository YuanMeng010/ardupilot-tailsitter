# MCU 
MCU STM32F4xx STM32F405xx

# ID
APJ_BOARD_ID 6578

# 外部始终
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 1024

# 启动内存地址（bootloader从0开始）
FLASH_RESERVE_START_KB 0

# 存放位置
FLASH_BOOTLOADER_LOAD_KB 48

# USB烧录
SERIAL_ORDER OTG1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

#stlink烧录
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD




# 片选
PD2 FLASH1_CS CS
PB12 OSD1_CS CS
PA4 GYRO1_CS CS
PC4 ACC1_CS CS

PC13 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0