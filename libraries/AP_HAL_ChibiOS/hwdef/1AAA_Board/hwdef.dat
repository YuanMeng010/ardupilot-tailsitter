
#系统配置

#MCU
MCU STM32F4xx STM32F405xx

#ID
APJ_BOARD_ID 6578

#外部晶振
OSCILLATOR_HZ 8000000

#MCU内存
FLASH_SIZE_KB 1024

#bootloader设置：0-48kb
FLASH_RESERVE_START_KB 48

#16KB作存储
define HAL_STORAGE_SIZE 16384
#第一页
define STORAGE_FLASH_PAGE 1
#TIM5作时间基准
STM32_ST_USE_TIMER 5



#SPI配置

#SPI1
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1


#SPI2
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2

#SPI3
# SPI3
PB3 SPI3_SCK SPI3
PB4 SPI3_MISO SPI3
PB5 SPI3_MOSI SPI3


#片选(IMU片选？)
PD2 FLASH1_CS CS
PB12 OSD1_CS CS
PA4 GYRO1_CS CS
PC4 ACC1_CS CS


#串口
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4

#USB OTG
# PA10 IO-debug-console
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1


#串口1 模拟图传和遥测
#PA10 USART1_RX USART1 NODMA
PA9 USART1_TX USART1 NODMA
define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_None

#串口2 接收机
PA2 USART2_TX USART2
PA3 USART2_RX USART2
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_RCIN

#串口3 大疆图传
PC10 USART3_TX USART3
PC11 USART3_RX USART3
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_MSP_DisplayPort

#串口4 GPS
PA0 UART4_TX UART4
PA1 UART4_RX UART4
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_GPS

#I2C
I2C_ORDER I2C1 I2C2

#I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

#I2C2
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2


#CAN
PB8 CAN1_RX CAN1
PB9 CAN1_TX CAN1

# ADC

#电池电压
PC5 BATT_VOLTAGE_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 15
define HAL_BATT_VOLT_SCALE 11.0

#电流
PB1 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_CURR_PIN 9
define HAL_BATT_CURR_SCALE 25.0

# 电机输出 M1,M2,M3,M4
PC6 TIM3_CH1 TIM3 PWM(1) GPIO(50)        
PC7 TIM3_CH2 TIM3 PWM(2) GPIO(51)
PC8 TIM3_CH3 TIM3 PWM(3) GPIO(52)        
PC9 TIM3_CH4 TIM3 PWM(4) GPIO(53)

#状态指示灯
define AP_NOTIFY_GPIO_LED_1_ENABLED 1
PC15 LED0 OUTPUT LOW GPIO(90)
define AP_NOTIFY_GPIO_LED_1_PIN 90

#OSD芯片
SPIDEV osd SPI2 DEVID1 OSD1_CS MODE0 10*MHZ 10*MHZ

define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin


# 气压计
define AP_BARO_BACKEND_DEFAULT_ENABLED 0
define AP_BARO_SPL06_ENABLED 1
BARO SPL06 I2C:0:0x76

#外部存储
SPIDEV dataflash SPI3 DEVID1 FLASH1_CS MODE3 104*MHZ 104*MHZ
define HAL_LOGGING_DATAFLASH_ENABLED 1

#IMU（加速度计+陀螺仪）
SPIDEV accel SPI1 DEVID1 ACC1_CS  MODE0 5*MHZ 10*MHZ
SPIDEV gyro  SPI1 DEVID1 GYRO1_CS MODE0 5*MHZ 10*MHZ

IMU BMI088 SPI:accel SPI:gyro ROTATION_ROLL_180  

DMA_NOSHARE TIM3_UP SPI1*   # 独占 DMA 通道（避免冲突）
DMA_PRIORITY TIM3_UP SPI1*  # 高优先级 DMA

#罗盘配置
#COMPASS IST8310 I2C:ALL_INTERNAL:0x0C false ROTATION_YAW_270   #？？？？？？？？？？？
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2
define HAL_DEFAULT_INS_FAST_SAMPLE 3

# 默认机架
define HAL_FRAME_TYPE_DEFAULT 12

include ../include/minimize_common.inc
define DEFAULT_NTF_LED_TYPES 1

